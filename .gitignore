# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the example template tracked (no secrets)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bkit / pdca tooling state (auto-generated, do not commit)
docs/.bkit-memory.json
docs/.pdca-status.json
docs/.pdca-snapshots/

# 공백 포함 원본 이미지(중복) — Vercel 배포 파이프라인 이슈 방지. festival-*.png 복사본 사용
public/img/day tennis landscape.png
public/img/day tennis vertical.png
public/img/glow tennis landscape.png
public/img/glow tennis vertical.png
