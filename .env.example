# =====================================================================
#  GCM Academy — 환경 변수 예시
# ---------------------------------------------------------------------
#  이 파일을 복사해 `.env.local` 로 만들고 실제 값을 채우세요.
#    cp .env.example .env.local
#  ⚠️ .env.local(실제 시크릿)은 커밋 금지. 이 예시 파일(.env.example)만 추적됩니다.
#  ※ 아래 `your-...` 플레이스홀더를 그대로 두면 해당 기능은 비활성 상태로 유지됩니다.
# =====================================================================

# --- 사이트 URL (sitemap / robots / 메타데이터 / OG 절대경로용) ---
#  미설정 시 코드 기본값(https://www.gcmacademy.com) 사용. 로컬은 http://localhost:3000 등.
NEXT_PUBLIC_SITE_URL=https://www.gcmacademy.com

# --- Supabase (GCM 전용 프로젝트) ---
#  대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
#  service_role 키: 서버 전용. 절대 클라이언트 노출/커밋 금지.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- 관리자 자가 가입 보호 키 (서버 전용) ---
#  관리자 계정 등록 시 요구되는 비밀 값. 임의의 긴 문자열로 설정.
ADMIN_SIGNUP_KEY=your-admin-signup-secret

# --- 네이버 소셜 로그인 (커스텀 OAuth) ---
#  developers.naver.com 에서 애플리케이션 등록 후 발급.
#  Client Secret 은 서버 전용(커밋 금지).
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# --- Resend (이메일 발송) ---
#  상담/문의 접수 알림 메일 발송용. resend.com API 키 + 인증된 발신 도메인 필요.
#  (Supabase 인증 메일 SMTP 설정은 대시보드에서 별도로 하며 여기 env 와 무관)
RESEND_API_KEY=your-resend-api-key
#  발신 주소 — Resend 에서 인증(verify)한 도메인이어야 함. 예: "GCM 아카데미 <noreply@gcmacademy.com>"
RESEND_FROM=GCM 아카데미 <noreply@your-domain>
#  알림 수신 주소(미설정 시 tennis.gcm@gmail.com)
INQUIRY_NOTIFY_TO=tennis.gcm@gmail.com
